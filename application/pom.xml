<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cx.myfluxo</groupId>
        <artifactId>myfluxo-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>myfluxo-application</artifactId>
    <packaging>jar</packaging>

    <description>
        Use cases (application services). Coordinates aggregates and repositories
        across a Unit of Work. Returns Result&lt;T,E&gt; — never throws domain errors.
        Depends on myfluxo-domain; depends on NO adapters (they wire into us).
    </description>

    <dependencies>
        <dependency>
            <groupId>cx.myfluxo</groupId>
            <artifactId>myfluxo-domain</artifactId>
        </dependency>

        <!-- SLF4J for audit logging (facade only; production binding lives in bootstrap). -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>io.avaje</groupId>
            <artifactId>avaje-inject</artifactId>
        </dependency>
        <dependency>
            <groupId>io.avaje</groupId>
            <artifactId>avaje-inject-generator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
